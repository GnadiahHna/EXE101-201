# Server & Environment
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Database & Múi giờ
MONGO_URI=mongodb://127.0.0.1:27017/clinic_booking
CLINIC_TIMEZONE=Asia/Ho_Chi_Minh
ENABLE_MONGO_TRANSACTIONS=true

# Security & Authentication (Hardened Phase 2)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
BCRYPT_ROUNDS=12
REQUIRE_EMAIL_VERIFICATION=false
TRUST_PROXY=loopback, linklocal, uniquelocal
REDIS_URL=
OAUTH_REDIRECT_BASE_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Transactional Outbox & Notification Worker
OUTBOX_ENABLE_WORKER=true
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_MAX_RETRIES=5

# First-Admin Bootstrap Protection (UC-ADM-10)
ADMIN_BOOTSTRAP_SECRET=
ADMIN_BOOTSTRAP_REQUIRE_SECRET=false

# OAuth2 Social Login (Google & Facebook)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Appointment Business Rules
MAX_PATIENTS_PER_APPOINTMENT=4
MAX_PENDING_APPOINTMENTS_PER_PATIENT=5
CANCEL_MIN_HOURS=24
CANCEL_LOCK_THRESHOLD=3
BOOKING_LOCK_DURATION_HOURS=24
CHECKIN_EARLY_MINUTES=60
SHIFT_CANCEL_POLICY=BLOCK_UNTIL_RESOLVED
RECEPTION_SEARCH_RATE_PER_MIN=30

# Online Consultation (UC-PAT-09 / UC-PAT-10)
JOIN_EARLY_MINUTES=15
JOIN_LATE_GRACE_MINUTES=15
ONLINE_REQUIRE_PAYMENT_BEFORE_JOIN=true
JOIN_TOKEN_SECRET=

# Payment & VNPay (UC-PAT-07 / UC-PAT-08 / FIX-1)
PAYMENT_PENDING_TTL_MINUTES=15
PAYMENT_APPOINTMENT_HOLD_MINUTES=30
PAYMENT_JOB_ENABLED=true
PAYMENT_JOB_INTERVAL_MS=60000
PAYMENT_SUCCESS_TARGET_STATE_ONLINE=CONFIRMED
PAYMENT_SUCCESS_TARGET_STATE_OFFLINE=PENDING_CONFIRMATION
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:5173/payment/vnpay-return
VNP_IPN_URL=http://localhost:3000/api/payments/vnpay-ipn

# Patient Feedback (UC-PAT-11 / UC-PAT-12)
FEEDBACK_EDIT_DAYS=7
FEEDBACK_RATE_PER_HOUR=10


# AI Chatbot & Clinical Intake Summary (Google Gemini)
DEMO_MODE=true
AI_PROCESSING_ENABLED=true
FEATURE_INTAKE_SUMMARY=true
INTAKE_SUMMARY_PREGENERATE=false
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3-flash-preview,gemini-flash-latest,gemini-2.5-flash-lite
CHAT_DAILY_BUDGET=500
INTAKE_SUMMARY_DAILY_BUDGET=200
CHAT_MIN_CONFIDENCE=0.55
CLINIC_NAME=Phòng khám Đa khoa Quốc tế Nano Clinic
CLINIC_ADDRESS=123 Đường Nguyễn Trãi, Quận 1, TP. Hồ Chí Minh
CLINIC_HOTLINE=1900 6868
CLINIC_OPEN_HOURS=Thứ 2 - Thứ 7: 07:30 - 20:00, Chủ Nhật: 08:00 - 12:00
