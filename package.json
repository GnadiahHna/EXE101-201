{
  "name": "clinicbooking-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "ClinicBooking Fullstack Runner (Backend + Web)",
  "scripts": {
    "dev": "trap 'kill 0' INT TERM EXIT; (cd backend && npm run dev) & (cd web && npm run dev) & wait",
    "start": "trap 'kill 0' INT TERM EXIT; (cd backend && npm start) & (cd web && npm run dev) & wait",
    "seed": "cd backend && npm run seed",
    "test": "cd backend && npm test",
    "docker:dev": "docker compose up --build",
    "prepare": "husky",
    "ci:local": "node scripts/ci-local.mjs"
  },
  "lint-staged": {
    "web/**/*.{ts,tsx}": [
      "npm run lint --prefix web"
    ],
    "backend/**/*.js": [
      "node --check"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
  }
}
